pipeline {
  agent any

  environment {
    PROD_HOST = credentials('prod-server-ip')      // Replace with actual IP or DNS
    PROD_USER = 'ec2-user'                          // Change if different
    REMOTE_APP_NAME = 'spring-petclinic-2.4.2.war'                   // Final name on the server
    REMOTE_APP_PATH = '/home/ec2-user/deployments'  // Target path on the server
  }

  stages {

    stage('Checkout Code') {
      steps {
        checkout scm
      }
    }

    stage('Build with Maven') {
      steps {
        sh 'mvn clean package -DskipTests -Dcheckstyle.skip'
      }
    }

    stage('Deploy to Production') {
      steps {
        sshagent(['prod-server-key']) {
          script {
            def warFile = sh(script: "ls target/*.war", returnStdout: true).trim()
            def remoteFullPath = "${REMOTE_APP_PATH}/${REMOTE_APP_NAME}"

            // Ensure remote deployment directory exists
            sh """
              ssh -o StrictHostKeyChecking=no ${PROD_USER}@${PROD_HOST} 'mkdir -p ${REMOTE_APP_PATH}'
            """

            // Upload WAR file to the remote server
            sh """
              scp -o StrictHostKeyChecking=no ${warFile} ${PROD_USER}@${PROD_HOST}:${remoteFullPath}
            """

            // Check and stop existing process
            sh """
              ssh -o StrictHostKeyChecking=no ${PROD_USER}@${PROD_HOST} 'sh ~/destroy.sh'
            """

            // start the application
            sh """
              ssh -o StrictHostKeyChecking=no ${PROD_USER}@${PROD_HOST} 'sh ~/start.sh'
            """
          }
        }
      }
    }
  }

  post {
    success {
      echo "Application deployed and started successfully on ${PROD_HOST}!"
    }
    failure {
      echo "Deployment failed."
    }
  }
}
